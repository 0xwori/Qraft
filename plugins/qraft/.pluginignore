# Local dependency and build output folders make plugin installation slow.
node_modules/
**/node_modules/
dist/
**/dist/
.vite/
**/.vite/
*.tsbuildinfo

# Git and local app state are not plugin source.
.git/
.codex/

# Runtime outputs and generated artifacts stay in the workspace.
outputs/
**/outputs/
exports/
**/exports/
**/.export/
ai-log/
**/ai-log/

# Secrets must never be packaged.
.env
**/.env
**/.env.*
!**/.env.example

# OS noise.
.DS_Store
